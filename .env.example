# Copy to .env and fill in. Never commit .env.

PAPERCLIP_URL=http://localhost:3100
PAPERCLIP_TOKEN=                # board API token (or PAPERCLIP_TOKEN_FILE=/path)

# Optional: GitHub token for the CI watcher (private repos, higher rate limit)
GITHUB_TOKEN=

PW_INTERVAL_SECONDS=60

# Watchers (true/false)
PW_ANSWERED_CARD=true           # card answered, task still blocked -> reopen
PW_DEPENDENCY_DONE=true         # all blocking issues done, task still blocked -> reopen
PW_CI_WAIT=true                 # "CI pending: owner/repo#123" -> reopen when CI finishes (or the PR conflicts)
PW_IDLE_ASSIGNED=true           # assigned todo/in_review with no run -> explicit wakeup
PW_BROKEN_SESSION=true          # two empty runs in a row -> reset session, start fresh
PW_UNEXPLAINED_BLOCKED=true     # blocked with no visible reason -> reopen
PW_BENIGN_AGENT_ERROR=true      # agent in "error" after its task was closed -> clear
PW_STALE_ALERT=true             # nothing moved for PW_STALE_HOURS -> alert a human
PW_TOKEN_FAILOVER=true          # agent secret disabled/rotated -> switch to the active one of the same family
PW_ORPHAN_BROWSERS=true         # stop headless browsers left behind by cancelled runs (same machine only)

PW_IDLE_MINUTES=10
PW_IDLE_MAX_NUDGES=2
PW_UNEXPLAINED_BLOCKED_MINUTES=15
PW_STALE_HOURS=2
PW_CI_MARKER=CI pending:
PW_ORPHAN_BROWSER_MINUTES=15
# PW_ORPHAN_BROWSER_PATTERN=ms-playwright[\\/]|puppeteer[\\/]|chrome-headless-shell

# Alerts (optional). Without these, alerts are only logged.
PW_TELEGRAM_BOT_TOKEN=
PW_TELEGRAM_CHAT_ID=
PW_WEBHOOK_URL=                 # receives {"source":"paperclip-watchdog","text":"..."}
# PW_STATE_FILE=~/.paperclip-watchdog/state.json
